{
  "name": "etta-time-tracker",
  "version": "0.1.0",
  "description": "ETTA desktop time-tracking application for Outlook and Jira.",
  "author": "UC San Diego",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "clean": "node scripts/clean-build.mjs",
    "dev": "concurrently --kill-others \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:desktop": "wait-on tcp:127.0.0.1:3000 && npm run build:electron && cross-env ELECTRON_START_URL=http://127.0.0.1:3000 electron .",
    "build": "npm run clean && npm run build:web && npm run build:electron && npm run stage:standalone",
    "build:web": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "stage:standalone": "node scripts/stage-next-standalone.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:mac:universal": "npm run build && electron-builder --mac --universal",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-virtual": "^3.13.18",
    "better-sqlite3": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "41.2.0",
    "electron-builder": "26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  }
}
